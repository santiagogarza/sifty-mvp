# debug-demo only: Debug Mode needs the real model call to reproduce the
# title race. The demo setup keeps every other branch offline through an
# untracked .env, which this file outranks; the key itself comes from the
# server's environment, never from a file in the repo.
SIFTY_AI_OFFLINE=0
# The free-tier model answers in ~2s, too fast to rename a task mid-triage.
SIFTY_TRIAGE_MIN_MS=6000
# The free-tier gateway key rejects the default model (Claude Haiku).
SIFTY_MODEL_OVERRIDE=gpt-4o-mini
