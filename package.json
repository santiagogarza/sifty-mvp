{
  "name": "sifty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "build:vercel": "pnpm db:migrate && next build",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "workflow:web": "workflow web",
    "workflow:runs": "workflow inspect runs",
    "invite:mint": "tsx --env-file-if-exists=.env.local scripts/invite.ts mint",
    "invite:revoke": "tsx --env-file-if-exists=.env.local scripts/invite.ts revoke",
    "invite:list": "tsx --env-file-if-exists=.env.local scripts/invite.ts list"
  },
  "dependencies": {
