# Sifty environment variables.
#
# Copy to .env.local for local dev. On Vercel, set them per scope
# (Production / Preview / Development). Three groups:
#
#   REQUIRED  — production refuses to build or boot without them.
#   OPTIONAL  — a feature degrades cleanly (503 + clear message) when unset.
#   DEV-ONLY  — demo and local-dev switches. Refused when VERCEL_ENV=production.

# =============================================================================
# REQUIRED
# =============================================================================

# Better Auth: signs session cookies and verification/reset tokens. At least
# 32 characters. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Postgres connection URL (pooled). Neon via the Vercel Marketplace sets this
# automatically. When unset outside production, Sifty runs on an in-memory
# store (data is lost on every restart); production refuses to build or boot
# without it.
DATABASE_URL=

# Direct (unpooled) Postgres URL used only for migrations (`pnpm db:migrate`,
# run before `next build` on Vercel). Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=

# Email address that gets the permanent unlimited tier.
CREATOR_EMAIL=s.gonzalez.garza@gmail.com

# Public URL of the deployed app. Used for OAuth callbacks and Stripe redirects.
# Production: https://<project>.vercel.app until a custom domain exists.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =============================================================================
# OPTIONAL
# =============================================================================

# --- Public site ---
# Shown in the footer, legal pages, and security.txt. Falls back to
# CREATOR_EMAIL when unset. Static pages bake it in at build time, so set it
# before deploying.
SUPPORT_EMAIL=

# --- Google sign-in (Better Auth) ---
# Leave both unset to hide the Google button. Cloud Console → OAuth client (Web)
# with redirect URI https://<host>/api/auth/callback/google (and
# http://localhost:3000/api/auth/callback/google for local dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Canonical origin for auth links/callbacks when it differs from
# NEXT_PUBLIC_APP_URL (e.g. a preview deployment).
# BETTER_AUTH_URL=

# --- AI transport ---
# "gateway" (default) routes every model through the Vercel AI Gateway with
# one key and server-side fallbacks. "direct" calls each provider's own API.
# The choice is explicit: Sifty never infers it from which keys are present,
# and a missing key for the chosen transport fails loudly (503 no_ai_key);
# the rest of the app keeps working.
AI_TRANSPORT=gateway

# Required when AI_TRANSPORT=gateway.
AI_GATEWAY_API_KEY=

# Required when AI_TRANSPORT=direct: every stage routes to Claude first, with
# one OpenAI fallback (see lib/ai/models.ts), so both keys are needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Email (Resend) ---
# Leave both unset to print every email (verification links included) to the
# server log instead of sending it. Set both to deliver through Resend.
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend (DKIM/SPF/DMARC).
# While testing without a domain, "Sifty <onboarding@resend.dev>" delivers to
# the Resend account owner's address only.
EMAIL_FROM=
# Optional Reply-To, e.g. a support mailbox.
# EMAIL_REPLY_TO=

# --- Invite codes ---
# Pepper mixed into the SHA-256 of invite codes before storage. Generate
# with: openssl rand -hex 32. Changing it invalidates every unredeemed code.
INVITE_CODE_PEPPER=

# --- Invite codes ---
# Pepper mixed into the SHA-256 of invite codes before storage. Generate
# with: openssl rand -hex 32. Changing it invalidates every unredeemed code.
INVITE_CODE_PEPPER=

# --- Stripe (Waimaka, Inc) ---
# Checkout, Customer Portal, and the webhook answer 503 until these exist.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price ids from the Stripe dashboard.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Migrations on preview deployments ---
# Off by default: without Neon preview branching, previews share the
# production database and must not alter its schema. Set to 1 only after
# enabling "create a branch per preview" on the Neon integration.
# SIFTY_MIGRATE_PREVIEWS=1

# --- Cron ---
# Bearer token Vercel Cron sends to /api/cron/*. Generate with: openssl rand -hex 32.
# Cron routes refuse to run (503) while it is unset.
CRON_SECRET=

# --- Background jobs (Vercel Workflow) ---
# Nothing to set. On Vercel the runtime picks the managed "Vercel World"
# from VERCEL_DEPLOYMENT_ID (keep "Enable access to System Environment
# Variables" on in the project settings); locally the Local World stores
# runs under .next/workflow-data. Optional overrides:
# WORKFLOW_LOCAL_DATA_DIR=.next/workflow-data
# WORKFLOW_TARGET_WORLD=local

# --- Sentry ---
# Server-side sink for reportError() and unhandled request errors. Everything
# is a no-op when unset. Same DSN works for both; NEXT_PUBLIC_ is the browser.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Rate limits (token bucket capacity overrides) ---
# RATELIMIT_TRIAGE_PER_MIN=30
# RATELIMIT_STRIPE_USER_PER_MIN=12
# RATELIMIT_STRIPE_WEBHOOK_PER_MIN=240
# RATELIMIT_REDEEM_PER_MIN=5
# RATELIMIT_REDEEM_PER_MIN=5
# RATELIMIT_ACCOUNT_EXPORT_PER_MIN=3

# =============================================================================
# DEV-ONLY — never set these on Vercel production; the build and the server
# refuse to start when VERCEL_ENV=production and any of them is set.
# =============================================================================

# Skip auth entirely (E2E, component dev). Every request runs as the bypass
# user. Ignored on Vercel production even if set.
# SIFTY_DISABLE_AUTH=1

# Email of the bypass user when SIFTY_DISABLE_AUTH=1. Defaults to CREATOR_EMAIL.
# SIFTY_USER_EMAIL=

# Populate every new account (and the bypass user) with a fully-triaged demo
# workspace on first run. Existing data is never touched.
# SIFTY_DEMO_SEED=1

# Run triage/briefs with the deterministic offline heuristic (keyless dev, CI).
# SIFTY_AI_OFFLINE=1

# Set by Vercel, not by you: production | preview | development. Local dev
# leaves it unset, which keeps every dev-only switch available.
# VERCEL_ENV=
