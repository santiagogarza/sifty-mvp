# Sifty environment variables.
# Copy to .env.local for local dev. In production these go on Vercel.

# --- App ---
# Public URL of the deployed app. Used for OAuth callbacks and Stripe success URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Auth ---
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Permanent unlimited account. Bypasses billing checks server-side.
CREATOR_EMAIL=s.gonzalez.garza@gmail.com

# Local-dev escape hatch: set to "1" to skip auth entirely (useful for E2E,
# component dev). Off in production.
# SIFTY_DISABLE_AUTH=

# Set to "1" to populate every new account (and the auth-bypass user) with a
# fully-triaged demo workspace: tasks across all views, labels, memories,
# and one prepared agent brief. Existing data is never touched.
# SIFTY_DEMO_SEED=

# Set to "1" to run triage/briefs with the deterministic offline heuristic —
# keyless local dev and CI. Never enable in production.
# SIFTY_AI_OFFLINE=

# --- Email (Resend) ---
# Leave both unset to print every email (verification links included) to the
# server log instead of sending it. Set both to deliver through Resend.
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend (DKIM/SPF/DMARC).
# While testing without a domain, "Sifty <onboarding@resend.dev>" delivers to
# the Resend account owner's address only.
EMAIL_FROM=
# Optional Reply-To, e.g. a support mailbox.
# EMAIL_REPLY_TO=

# --- Invite codes ---
# Pepper mixed into the SHA-256 of invite codes before storage. Generate
# with: openssl rand -hex 32. Changing it invalidates every unredeemed code.
INVITE_CODE_PEPPER=

# --- Database ---
# Postgres connection URL. Vercel Postgres / Neon / Supabase Postgres all work.
# When unset, Sifty falls back to in-memory storage (data is lost on restart).
DATABASE_URL=

# --- AI transport ---
# "gateway" (default) routes every model through the Vercel AI Gateway with
# one key and server-side fallbacks. "direct" calls each provider's own API.
# The choice is explicit: Sifty never infers it from which keys are present,
# and a missing key for the chosen transport fails loudly (503 no_ai_key).
AI_TRANSPORT=gateway

# Required when AI_TRANSPORT=gateway.
AI_GATEWAY_API_KEY=

# Required when AI_TRANSPORT=direct: every stage routes to Claude first, with
# one OpenAI fallback (see lib/ai/models.ts), so both keys are needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Recurring price ids from your Stripe dashboard.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- Rate limits (optional overrides) ---
# RATELIMIT_TRIAGE_PER_MIN=30
# RATELIMIT_STRIPE_USER_PER_MIN=12
# RATELIMIT_STRIPE_WEBHOOK_PER_MIN=240
# RATELIMIT_REDEEM_PER_MIN=5
